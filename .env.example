# Copy this file to .env and fill in the real values (ask a teammate
# for them, or run `turso db show campuscart --url` / `turso db tokens
# create campuscart` if you created the database yourself).
# .env is gitignored -- never commit real credentials here.

TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token
# Signs the login cookie. Make one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
